{
    "forImport": {
        "toInsertLine": "import { router as routerFromv1 } from './v1/routes.js';",
        "toInsertRule": "defaultBefore",
        "inKeyInSummary": "importSummary",
        "toCheckLinesName": "importLines",
        "aboutInsertIndex": {
            "toInsertRule": "defaultBefore",
            "toCheckKey": "importSummary",
            "toCheckEmptyKey": "consumeSummary",
            "toCheckEmpty2Key": "importFromNpmSummary",
            "considerTop": false,
            "considerBottom": true
        },
        "regexNeeded": {
            "keyNeeded": "importRegex.parseRegex"
        }
    },
    "forConsumption": {
        "toInsertLine": "router.use('/v1', routerFromv1);",
        "toInsertRule": "defaultBefore",
        "inKeyInSummary": "consumeSummary",
        "toCheckLinesName": "useLines",
        "aboutInsertIndex": {
            "toInsertRule": "defaultBefore",
            "toCheckKey": "consumeSummary",
            "toCheckEmptyKey": "exportSummary",
            "considerTop": false,
            "considerBottom": true
        },
        "regexNeeded": {
            "keyNeeded": "consumptionRegex.parseRegex"
        }
    }
}